NODE_ENV=production
PORT=3000
TZ=Asia/Bangkok

# ubuntu-run.sh generates strong values automatically on first run.
SESSION_SECRET=change-this-to-a-long-random-secret
SETTINGS_ENCRYPTION_KEY=change-this-settings-encryption-key
# Direct IP:7400 is HTTP, so keep this false. Set true only when HTTPS reaches Caddy.
SESSION_COOKIE_SECURE=false

DB_HOST=mysql
DB_PORT=3306
DB_NAME=drone_alert
DB_USER=dronealert
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password

# Public listener on the Ubuntu host. MikroTik should forward TCP 7400 to this port.
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=7400

LINE_LIFF_ID=
LINE_CHANNEL_ID=

# Gemini AI Smart Fill. Create a Free Tier API key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SMART_FILL_MAX_PER_10MIN=12

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

# Optional: identify this installation when using OpenStreetMap Nominatim search.
GEOCODER_USER_AGENT=DroneAlert/0.2 ubuntu-operations-dashboard
