NODE_ENV=development
PORT=3000
TZ=Asia/Bangkok
SESSION_SECRET=change-this-to-a-long-random-secret

DB_HOST=mysql
DB_PORT=3306
DB_NAME=drone_alert
DB_USER=dronealert
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password

# Local: http://localhost
# Production example: drone.example.com
SITE_ADDRESS=http://localhost

LINE_LIFF_ID=
LINE_CHANNEL_ID=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

# Optional: identify this installation when using OpenStreetMap Nominatim search.
GEOCODER_USER_AGENT=DroneAlert/0.2 local-operations-dashboard
